/* ==========================================================
   PORTFOLIO — style.css (version 3)
   Couleurs : modifie uniquement les variables ci-dessous.
   ========================================================== */

/* ---------- 1. Variables : thème sombre (par défaut) ---------- */
:root {
  color-scheme: dark;
  --bg: #130c08;
  --bg-alt: #1b120c;
  --card: #25180f;
  --text: #f9efe1;
  --muted: #d0bba2;
  --accent: #ffb347;          /* ambre doré */
  --accent-2: #ff8a3d;        /* orange chaud (dégradés) */
  --on-accent: #1a0f08;       /* texte posé sur l'accent */
  --border: #45321f;
  --glow: rgba(255, 179, 71, .28);
  --grid: rgba(255, 179, 71, .06);   /* quadrillage « réseau » du hero */
  --shadow: 0 14px 34px rgba(0, 0, 0, .4);
  --radius: 16px;
  --max: 1120px;
  --nav-h: 68px;
  --font: "Segoe UI", system-ui, -apple-system, Roboto, Arial, sans-serif;
  --font-title: Georgia, "Times New Roman", serif;
  --ease: cubic-bezier(.2, .7, .2, 1);
}

/* ---------- 2. Thème clair (beige) ---------- */
[data-theme="light"] {
  color-scheme: light;
  --bg: #faf3e9;
  --bg-alt: #f2e6d4;
  --card: #fffaf2;
  --text: #2a1d14;
  --muted: #624d3b;
  --accent: #a3441a;
  --accent-2: #c4621f;
  --on-accent: #fffaf2;
  --border: #dccab3;
  --glow: rgba(163, 68, 26, .2);
  --grid: rgba(163, 68, 26, .07);
  --shadow: 0 12px 28px rgba(80, 45, 20, .12);
}

/* ---------- 3. Base ---------- */
*, *::before, *::after { box-sizing: border-box; }
html { scroll-behavior: smooth; scroll-padding-top: calc(var(--nav-h) + 8px); -webkit-text-size-adjust: 100%; }
body { margin: 0; overflow-x: hidden; font: 1.02rem/1.7 var(--font); color: var(--text); background: var(--bg); transition: background .3s, color .3s; -webkit-font-smoothing: antialiased; }
img { display: block; max-width: 100%; }
a { color: var(--accent); text-underline-offset: 3px; }
a:hover { color: var(--accent-2); }
h1, h2, h3 { margin: 0 0 .5em; font-family: var(--font-title); line-height: 1.15; letter-spacing: -.01em; text-wrap: balance; }
h2 { margin-bottom: 1.6rem; font-size: clamp(1.9rem, 4.2vw, 2.6rem); }
h2::after { content: ""; display: block; width: 64px; height: 4px; margin-top: .65rem; border-radius: 4px; background: linear-gradient(90deg, var(--accent), var(--accent-2)); }
h3 { font-size: 1.15rem; line-height: 1.3; }
p { margin: 0 0 1em; }
ul { margin: 0; padding-left: 1.1em; }
::selection { background: var(--accent); color: var(--on-accent); }
:focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; border-radius: 6px; }
* { scrollbar-width: thin; scrollbar-color: var(--accent) var(--bg-alt); }
.skip { position: absolute; left: -999px; z-index: 200; padding: .6rem 1rem; background: var(--accent); color: var(--on-accent); }
.skip:focus { left: 10px; top: 10px; }

/* ---------- 4. Mise en page ---------- */
.container { width: min(100% - 2.5rem, var(--max)); margin-inline: auto; }
.section { padding: clamp(3.5rem, 8vw, 6rem) 0; }
.section.alt { background: var(--bg-alt); border-block: 1px solid var(--border); }
.section-intro { max-width: 62ch; margin-bottom: 2.2rem; color: var(--muted); }
.grid { display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); }
.two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; }

/* ---------- 5. Boutons ---------- */
.btn { display: inline-block; padding: .75rem 1.5rem; border: 2px solid var(--accent); border-radius: 999px; background: linear-gradient(135deg, var(--accent), var(--accent-2)); color: var(--on-accent); font: inherit; font-weight: 700; line-height: 1.3; text-decoration: none; cursor: pointer; transition: transform .2s var(--ease), box-shadow .2s, background .2s, color .2s; }
.btn:hover { color: var(--on-accent); transform: translateY(-2px); box-shadow: 0 8px 26px var(--glow); }
.btn:active { transform: none; }
.btn.ghost { background: transparent; color: var(--accent); }
.btn.ghost:hover { background: var(--accent); color: var(--on-accent); }
.btn.small { padding: .45rem 1.05rem; font-size: .9rem; }

/* ---------- 6. Navbar ---------- */
.navbar { position: fixed; inset: 0 0 auto; z-index: 100; height: var(--nav-h); border-bottom: 1px solid var(--border); background: color-mix(in srgb, var(--bg) 86%, transparent); -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px); }
.nav-inner { display: flex; align-items: center; justify-content: space-between; gap: 1rem; height: 100%; }
.logo { font: 700 1.2rem var(--font-title); color: var(--text); text-decoration: none; white-space: nowrap; }
.logo:hover { color: var(--accent); }
.nav-links { display: flex; gap: .2rem; margin: 0; padding: 0; list-style: none; }
.nav-links a { display: block; padding: .4rem .7rem; border-radius: 999px; color: var(--muted); font-size: .85rem; text-decoration: none; white-space: nowrap; transition: color .2s, background .2s; }
.nav-links a:hover { color: var(--text); background: color-mix(in srgb, var(--accent) 12%, transparent); }
.nav-links a.active { color: var(--on-accent); background: var(--accent); font-weight: 600; }
.nav-actions { display: flex; align-items: center; gap: .6rem; }
.icon-btn { display: grid; place-items: center; width: 40px; height: 40px; border: 1px solid var(--border); border-radius: 50%; background: var(--card); color: var(--text); font-size: 1.1rem; cursor: pointer; transition: border-color .2s, transform .25s var(--ease); }
.icon-btn:hover { border-color: var(--accent); transform: rotate(15deg); }
.burger { display: none; }

/* ---------- 7. Hero ---------- */
.hero { display: flex; align-items: center; min-height: 100vh; padding: calc(var(--nav-h) + 2rem) 0 3rem; background:
  radial-gradient(ellipse 55% 50% at 82% 30%, var(--glow), transparent 70%),
  radial-gradient(ellipse 40% 40% at 8% 92%, var(--glow), transparent 70%),
  linear-gradient(var(--grid) 1px, transparent 1px) 0 0 / 44px 44px,
  linear-gradient(90deg, var(--grid) 1px, transparent 1px) 0 0 / 44px 44px; }
.hero-grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: 3rem; align-items: center; }
.hero .meta { margin-bottom: .4rem; color: var(--muted); }
.hero h1 { font-size: clamp(2.5rem, 6.5vw, 4.5rem); line-height: 1.04; background: linear-gradient(90deg, var(--text) 35%, var(--accent)); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
.hero .title { margin-bottom: 1rem; color: var(--accent); font-size: clamp(1.05rem, 2.2vw, 1.35rem); font-weight: 600; }
.hero .lead { max-width: 56ch; color: var(--muted); font-size: 1.08rem; }
.cta-row, .social-row { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: 1.5rem; }
.avatar { display: grid; place-items: center; width: min(100%, 330px); aspect-ratio: 1; margin-inline: auto; overflow: hidden; border: 3px solid var(--accent); border-radius: 50%; background: var(--card); box-shadow: 0 0 0 10px var(--glow), 0 0 70px var(--glow); font: 4.2rem var(--font-title); color: var(--accent); }
.avatar img { width: 100%; height: 100%; object-fit: cover; }
.hero-text > * { animation: rise .8s var(--ease) both; }
.hero-text > :nth-child(2) { animation-delay: .08s; } .hero-text > :nth-child(3) { animation-delay: .16s; }
.hero-text > :nth-child(4) { animation-delay: .24s; } .hero-text > :nth-child(5) { animation-delay: .32s; }
.hero-text > :nth-child(6) { animation-delay: .4s; }
@keyframes rise { from { opacity: 0; transform: translateY(22px); } }

/* ---------- 8. Cartes, badges ---------- */
.card { position: relative; overflow: hidden; padding: 1.6rem; border: 1px solid var(--border); border-radius: var(--radius); background: var(--card); box-shadow: var(--shadow); transition: transform .3s var(--ease), border-color .3s, box-shadow .3s; }
.card::before { content: ""; position: absolute; inset: 0 0 auto; height: 3px; background: linear-gradient(90deg, var(--accent), var(--accent-2)); transform: scaleX(0); transform-origin: left; transition: transform .4s var(--ease); }
.card:hover { transform: translateY(-5px); border-color: var(--accent); box-shadow: 0 16px 40px var(--glow); }
.card:hover::before { transform: scaleX(1); }
.card .meta { margin-bottom: .6rem; color: var(--muted); font-size: .86rem; }
.tags { display: flex; flex-wrap: wrap; gap: .45rem; margin: .6rem 0 1rem; padding: 0; list-style: none; }
.tags li { padding: .18rem .8rem; border: 1px solid color-mix(in srgb, var(--accent) 55%, transparent); border-radius: 999px; background: color-mix(in srgb, var(--accent) 10%, transparent); font-size: .82rem; transition: background .2s, color .2s; }
.tags li:hover { background: var(--accent); color: var(--on-accent); }
.thumb { display: grid; place-items: center; height: 150px; margin-bottom: 1rem; border: 1px dashed var(--border); border-radius: 12px; color: var(--muted); font-size: .9rem; background: repeating-linear-gradient(45deg, var(--bg-alt), var(--bg-alt) 10px, var(--card) 10px, var(--card) 20px); }
.doc-list { display: flex; flex-wrap: wrap; gap: .5rem; margin: .4rem 0 0; padding: 0; list-style: none; }

/* ---------- 9. Timeline ---------- */
.timeline { margin: 0; padding: 0 0 0 1.8rem; border-left: 2px solid var(--border); list-style: none; }
.timeline li { position: relative; margin-bottom: 2rem; padding: 1.2rem 1.4rem; border: 1px solid var(--border); border-radius: var(--radius); background: var(--card); transition: border-color .3s, transform .3s var(--ease); }
.timeline li:hover { border-color: var(--accent); transform: translateX(4px); }
.timeline li::before { content: ""; position: absolute; left: calc(-1.8rem - 8px); top: 1.5rem; width: 14px; height: 14px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 5px var(--glow); }
.timeline .date { display: inline-block; margin-bottom: .3rem; color: var(--accent); font-size: .9rem; font-weight: 700; }
.timeline .meta { margin-bottom: .5rem; color: var(--muted); font-size: .9rem; }

/* ---------- 10. Formulaire & contact ---------- */
.form { display: grid; gap: 1.1rem; }
.field label { display: block; margin-bottom: .3rem; font-weight: 600; }
.field input, .field textarea { width: 100%; padding: .8rem 1rem; border: 1px solid var(--border); border-radius: 12px; background: var(--card); color: var(--text); font: inherit; transition: border-color .2s, box-shadow .2s; }
.field input:focus, .field textarea:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 4px var(--glow); }
.field textarea { min-height: 150px; resize: vertical; }
.error { display: block; min-height: 1.3em; color: #f08a6b; font-size: .85rem; }
[data-theme="light"] .error { color: #b3361b; }
.form-status { margin: 0; padding: .9rem 1.1rem; border: 1px solid var(--accent); border-radius: 12px; background: var(--card); }
.contact-list { padding: 0; list-style: none; }
.contact-list li { margin-bottom: .9rem; padding-bottom: .9rem; border-bottom: 1px solid var(--border); overflow-wrap: anywhere; }

/* ---------- 11. Footer ---------- */
.footer { padding: 2.5rem 0; border-top: 1px solid var(--border); background: var(--bg-alt); }
.footer-grid { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.5rem; }
.footer ul { display: flex; flex-wrap: wrap; gap: 1rem; margin: .4rem 0 .6rem; padding: 0; list-style: none; }
.footer small { color: var(--muted); }

/* ---------- 12. Visionneuse PDF ---------- */
#pdf-dialog { width: min(96vw, 1000px); height: 90vh; padding: 0; overflow: hidden; border: 1px solid var(--accent); border-radius: var(--radius); background: var(--card); color: var(--text); box-shadow: 0 0 60px var(--glow); }
#pdf-dialog[open] { display: flex; flex-direction: column; animation: rise .3s var(--ease); }
#pdf-dialog::backdrop { background: rgba(10, 5, 2, .75); -webkit-backdrop-filter: blur(3px); backdrop-filter: blur(3px); }
.pdf-bar { display: flex; justify-content: space-between; gap: 1rem; padding: .7rem 1rem; border-bottom: 1px solid var(--border); }
#pdf-frame { flex: 1; width: 100%; border: 0; background: #fff; }

/* ---------- 13. Animation au scroll ---------- */
.reveal { opacity: 0; transform: translateY(26px); transition: opacity .8s var(--ease), transform .8s var(--ease); }
.reveal.visible { opacity: 1; transform: none; }

/* ---------- 14. Responsive ---------- */
@media (max-width: 1180px) {   /* 9 liens : menu hamburger */
  .burger { display: grid; }
  .nav-links { position: absolute; top: var(--nav-h); left: 0; right: 0; display: none; flex-direction: column; gap: 0; max-height: calc(100vh - var(--nav-h)); overflow-y: auto; padding: .5rem 1.25rem 1rem; border-bottom: 1px solid var(--border); background: var(--bg); box-shadow: var(--shadow); }
  .nav-links.open { display: flex; }
  .nav-links a { padding: .8rem .4rem; border-radius: 8px; font-size: 1rem; }
}
@media (max-width: 760px) {
  .hero { min-height: auto; }
  .hero-grid, .two-col { grid-template-columns: 1fr; gap: 2rem; }
  .avatar { order: -1; width: 210px; }
  .cv-btn { display: none; }
  .timeline li:hover { transform: none; }
}
@media (prefers-reduced-motion: reduce) {
  * { animation: none !important; transition: none !important; scroll-behavior: auto !important; }
  .reveal { opacity: 1; transform: none; }
}
